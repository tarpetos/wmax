{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WMAX",
  "version": "1.0.0",
  "identifier": "com.tarpetos.wmax",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "title": "WMAX",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
